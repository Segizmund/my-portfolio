---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { iconMap } from '../../../components/icons/map';
import { getTranslations } from '../../../i18n/utils';
import '@fancyapps/ui/dist/fancybox/fancybox.css';

const t = getTranslations(Astro.url);

export async function getStaticPaths() {
    const languages = ['ru', 'en'];
    const projects = await getCollection('projects');
    
    return languages.flatMap((lang) => {
        return projects.map((entry) => ({
            params: { lang, slug: entry.id },
            props: { entry },
        }));
    });
}

const { lang } = Astro.params;
const { entry } = Astro.props;

const project = entry.data;

const isEn = lang === 'en';
const title = isEn ? project.titleUs : project.titleRu;
const description = isEn ? project.descriptionUs : project.descriptionRu;
const aboutText = isEn ? project.aboutUs : project.aboutRu;
const tasks = isEn ? project.tasksUs : project.tasksRu;
const ogImage = project.previewUrl || (project.arrayImgUrls && project.arrayImgUrls[0]);
---

<Layout 
    title={`${title} | Portfolio`}
    description={description}
    image={ogImage}
>
    <main class="max-w-4xl mx-auto px-4 py-8">
        <!-- Кнопка назад -->
        <a href={`/${lang}/`} class="inline-flex items-center text-xs text-sky-400 border-b border-transparent hover:border-current transition duration-300 ease-linear mb-6">
            ← {t('project.back')}
        </a>

        <!-- Заголовок и описание -->
        <h1 class="text-3xl font-bold text-white mb-3">{title}</h1>
        <p class="text-slate-400 mb-6 leading-relaxed">{description}</p>

        <!-- Стек технологий -->
        {project.stack && project.stack.length > 0 && (
            <div class="mb-8">
                <h2 class="text-xs uppercase font-bold tracking-widest text-slate-400 mb-3">
                    {t('project.stack')}
                </h2>
                <div class="flex flex-wrap gap-2">
                    {project.stack.map((techKey: string) => {
                        const Icon = iconMap[techKey.toLowerCase()];

                        return (
                            <>
                                {Icon && <Icon />}
                            </>
                        );
                    })}
                </div>
            </div>
        )}

        <!-- Главное превью -->
        {project.previewUrl && (
            <div class="mb-8 rounded-xl overflow-hidden border border-slate-800/80 bg-[#12141c]/80 group relative min-h-[200px]">
                <div class="gallery-skeleton absolute inset-0 bg-slate-800/50 animate-pulse flex items-center justify-center">
                    <svg class="w-6 h-6 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <a href={project.previewUrl} data-fancybox="gallery" data-caption={title}
                class="block cursor-zoom-in overflow-hidden relative z-10">
                    <img 
                        src={project.previewUrl} 
                        alt={title} 
                        class="gallery-img w-full h-auto object-cover opacity-0 group-hover:scale-110 transition-all duration-500 ease-out" 
                        loading="lazy"
                        onload="this.classList.remove('opacity-0'); this.closest('.group').querySelector('.gallery-skeleton')?.classList.add('hidden');"
                    />
                </a>
            </div>
        )}

        <!-- О проекте -->
        {aboutText && (
            <div class="prose prose-invert max-w-none mb-8 whitespace-pre-line text-slate-300 leading-relaxed">
                {aboutText}
            </div>
        )}

        <!-- Задачи -->
        {tasks && tasks.length > 0 && (
            <div class="mb-8">
                <h2 class="text-xs uppercase font-bold tracking-widest text-slate-400 mb-4">
                    {t('project.tasks')}
                </h2>
                
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    {tasks.map((task) => (
                        <div class="p-4 bg-[#12141c]/80 border border-slate-800/80 rounded-xl flex flex-col">
                            <h3 class="text-sm font-semibold text-sky-400 mb-1.5">
                                {task.title}
                            </h3>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                {task.text}
                            </p>
                        </div>
                    ))}
                </div>
            </div>
        )}

        <!-- Галерея -->
        {project.arrayImgUrls && project.arrayImgUrls.length > 0 && (
            <div class="space-y-4 mt-8">
                <h2 class="text-xs uppercase font-bold tracking-widest text-slate-400">
                    {t('project.gallery')}
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {project.arrayImgUrls.map((imgUrl, index) => {
                        const isLast = index === project.arrayImgUrls.length - 1;
                        const isOdd = project.arrayImgUrls.length % 2 !== 0;
                        const shouldBeFullWidth = isLast && isOdd;
                        
                        return (
                            <div class={`${shouldBeFullWidth ? 'sm:col-span-2' : 'col-span-1'} rounded-xl overflow-hidden border border-slate-800/80 bg-[#12141c]/80 group relative min-h-[200px]`}>
                                <div class="gallery-skeleton absolute inset-0 bg-slate-800/50 animate-pulse flex items-center justify-center">
                                    <svg class="w-6 h-6 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                
                                <a 
                                    href={imgUrl} 
                                    data-fancybox="gallery" 
                                    data-caption={`${title} — ${isEn ? 'Photo' : 'Фото'} ${index + 1}`}
                                    class="block cursor-zoom-in overflow-hidden relative z-10"
                                >
                                    <img 
                                        src={imgUrl} 
                                        alt={`${title} ${index + 1}`} 
                                        class="gallery-img w-full h-auto object-cover opacity-0 group-hover:scale-110 transition-all duration-500 ease-out" 
                                        loading="lazy"
                                        onload="this.classList.remove('opacity-0'); this.closest('.group').querySelector('.gallery-skeleton')?.classList.add('hidden');"
                                    />
                                </a>
                            </div>
                        );
                    })}
                </div>
            </div>
        )}
    </main>
</Layout>

<script>
    import { Fancybox } from "@fancyapps/ui";

    Fancybox.bind("[data-fancybox='gallery']", {
        Hash: false,
        Thumbs: {
            autoStart: false,
        },
    });
</script>