---
import { getTranslations, getLangFromUrl } from '../i18n/utils';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    article?: boolean;
}

const currentLang = getLangFromUrl(Astro.url);
const t = getTranslations(Astro.url);

const {
    title = t('seo.defaultTitle'),
    description = t('seo.defaultDescription'),
    image = t('seo.ogImage'),
    article = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(ru|en)/, '') || '/';
const ruUrl = new URL(`/ru${pathWithoutLang}`, Astro.site);
const enUrl = new URL(`/en${pathWithoutLang}`, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={t('seo.keywords')} />
<link rel="canonical" href={canonicalURL} />

<!-- i18n Alternate Links -->
<link rel="alternate" hreflang="ru" href={ruUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={ruUrl} />

<!-- Open Graph / Telegram / VK / WhatsApp -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={t('seo.siteName')} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'ru_RU'} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />