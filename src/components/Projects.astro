---
import { getCollection } from 'astro:content';
import { getTranslations, getLangFromUrl } from '../i18n/utils';
import { iconMap } from '../components/icons/map';

const t = getTranslations(Astro.url);
const currentLang = getLangFromUrl(Astro.url);
const isEn = currentLang === 'en';

const projectsCollection = await getCollection('projects');

// Массив ключей категорий в нужном порядке отображения
const categories = [
    { key: 'main', labelKey: 'category.main' },
    { key: 'pet-project', labelKey: 'category.pet-project' },
    { key: 'freelance', labelKey: 'category.freelance' },
] as const;
---

<section class="mb-12">
    <h2 class="text-xs uppercase font-bold tracking-widest text-slate-400 mb-6">
        {t('nav.projects')}
    </h2>
    
    <div class="space-y-10">
        {categories.map((cat) => {
            const categoryProjects = projectsCollection.filter(
                (item) => item.data.category === cat.key
            );

            if (categoryProjects.length === 0) return null;

            return (
                <div>
                    <!-- Заголовок подкатегории через t() -->
                    <h3 class="text-sm font-bold text-sky-400 mb-4 flex items-center gap-2">
                        <span>{t(cat.labelKey)}</span>
                        <span class="text-xs text-slate-500 font-normal">({categoryProjects.length})</span>
                    </h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {categoryProjects.map((item) => {
                            const project = item.data;
                            const slug = item.id;
                            const title = isEn ? project.titleUs : project.titleRu;
                            const description = isEn ? project.descriptionUs : project.descriptionRu;
                            const mainImage = project.previewUrl || (project.arrayImgUrls && project.arrayImgUrls[0]);
                            const projectLink = `/${currentLang}/projects/${slug}`;

                            return (
                                <a 
                                    href={projectLink} 
                                    class="flex flex-col justify-between bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700/80 transition-all group block cursor-pointer"
                                >
                                    <div>
                                        {mainImage && (
                                            <div class="mb-4 aspect-video rounded-xl overflow-hidden bg-[#1a1d29] border border-slate-700/50 relative">
                                                <img 
                                                    src={mainImage} 
                                                    alt={title} 
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                                    loading="lazy"
                                                />
                                            </div>
                                        )}

                                        <div class="flex flex-wrap gap-1.5 mb-3">
                                            {project.stack?.map((techKey: string) => {
                                                const Icon = iconMap[techKey.toLowerCase()];
                                                return Icon ? <Icon /> : null;
                                            })}
                                        </div>

                                        <h4 class="text-base font-bold text-white group-hover:text-sky-400 transition-colors mb-2">
                                            {title}
                                        </h4>

                                        <p class="text-xs text-slate-400 leading-relaxed mb-4 line-clamp-2">
                                            {description}
                                        </p>
                                    </div>

                                    <div class="text-[10px] text-slate-500 pt-2 border-t border-slate-800/60 flex justify-between items-center">
                                        {project.arrayImgUrls && project.arrayImgUrls.length > 0 ? (
                                            <span>{project.arrayImgUrls.length} {isEn ? 'photos' : 'фото'}</span>
                                        ) : (
                                            <span>{t('projects.more')}</span>
                                        )}
                                        <span class="text-sky-400 group-hover:translate-x-1 transition-transform font-bold">→</span>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                </div>
            );
        })}
    </div>
</section>