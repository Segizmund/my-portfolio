---
import { getTranslations } from '../i18n/utils';
const t = getTranslations(Astro.url);
---

<section class="bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-6 mb-8 shadow-2xl">
    <h2 class="text-xs uppercase font-bold tracking-widest text-slate-400 mb-3">{t('nav.about')}</h2>
    <p class="text-slate-300 text-sm md:text-base leading-relaxed">
        {t('about.me')}
    </p>
</section>