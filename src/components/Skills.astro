---
import { getTranslations } from '../i18n/utils';
import { 
    PhpIcon, 
    LaravelIcon, 
    EloquentIcon, 
    RestApiIcon, 
    BladeIcon, 
    CodeIgniterIcon, 
    TwigIcon, 
    JsIcon, 
    TsIcon, 
    ReactIcon, 
    AstroIcon, 
    InertiaIcon, 
    ViteIcon, 
    TailwindIcon, 
    BootstrapIcon, 
    MaplibreIcon, 
    WebComponentsIcon, 
    ModelViewerIcon, 
    DockerIcon, 
    GitIcon, 
    NginxIcon, 
    NpmIcon, 
    YarnIcon, 
    MySQLIcon, 
    PostgreSQLIcon, 
    PHPUnitIcon 
} from './icons';

const t = getTranslations(Astro.url);
---

<section class="mb-12">
    <h2 class="text-xs uppercase font-bold tracking-widest text-slate-400 mb-4">{t('nav.skills')}</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    
        <!-- Backend -->
        <div class="bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700/80 transition duration-300 easy-leaner">
            <h3 class="text-slate-400 font-medium text-xs mb-3">Backend</h3>
            <div class="flex flex-wrap gap-2">
                <PhpIcon />

                <LaravelIcon />

                <EloquentIcon />

                <CodeIgniterIcon />

                <RestApiIcon />

                <BladeIcon />

                <TwigIcon />
            </div>
        </div>

        <!-- Frontend -->
        <div class="bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700/80 transition duration-300 easy-leaner">
            <h3 class="text-slate-400 font-medium text-xs mb-3">Frontend</h3>
            <div class="flex flex-wrap gap-2">
                <JsIcon />

                <TsIcon />

                <ReactIcon />

                <AstroIcon />

                <InertiaIcon />

                <ViteIcon />
            </div>
        </div>

        <!-- UI & Cartography -->
        <div class="bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700/80 transition duration-300 easy-leaner">
            <h3 class="text-slate-400 font-medium text-xs mb-3">UI & Cartography</h3>
            <div class="flex flex-wrap gap-2">
                <TailwindIcon />

                <BootstrapIcon />

                <MaplibreIcon />

                <WebComponentsIcon />

                <ModelViewerIcon />
            </div>
        </div>

        <!-- Tools & DevOps -->
        <div class="bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700/80 transition duration-300 easy-leaner">
            <h3 class="text-slate-400 font-medium text-xs mb-3">Tools & DevOps</h3>
            <div class="flex flex-wrap gap-2">
                <GitIcon />

                <DockerIcon />

                <NginxIcon />

                <NpmIcon />

                <YarnIcon />
            </div>
        </div>

        <!-- Databases -->
        <div class="bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700/80 transition duration-300 easy-leaner">
            <h3 class="text-slate-400 font-medium text-xs mb-3">Databases</h3>
            <div class="flex flex-wrap gap-2">
                <MySQLIcon />

                <PostgreSQLIcon />
            </div>
        </div>

        <!-- Testing -->
        <div class="bg-[#12141c]/80 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700/80 transition duration-300 easy-leaner">
            <h3 class="text-slate-400 font-medium text-xs mb-3">Testing</h3>
            <div class="flex flex-wrap gap-2">
                <PHPUnitIcon />
            </div>
        </div>

    </div>
</section>