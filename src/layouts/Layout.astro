---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang="ru" class="dark">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<style>
			@keyframes brightPulse1 {
				0%, 100% { 
					opacity: 0.4; 
					transform: scale(0.9); 
				}
				50% { 
					opacity: 0.9; 
					transform: scale(1.4); 
				}
			}

			@keyframes brightPulse2 {
				0%, 100% { 
					opacity: 0.3; 
					transform: scale(0.85); 
				}
				50% { 
					opacity: 0.8; 
					transform: scale(1.6); 
				}
			}

			@keyframes brightPulse3 {
				0%, 100% { 
					opacity: 0.3; 
					transform: scale(0.9); 
				}
				50% { 
					opacity: 0.85; 
					transform: scale(1.5); 
				}
			}

			.pulse-blob-1 {
				animation: brightPulse1 6s ease-in-out infinite;
			}

			.pulse-blob-2 {
				animation: brightPulse2 7s ease-in-out infinite 0.5s;
			}

			.pulse-blob-3 {
				animation: brightPulse3 5s ease-in-out infinite 1s;
			}
			@keyframes gridPulse {
				0%, 100% { opacity: 0.2; }
				50% { opacity: 0.7; }
			}

			.grid-animate {
				animation: gridPulse 8s ease-in-out infinite;
			}
		</style>
	</head>
	<body class="bg-[#0b0c10] text-slate-200 antialiased relative min-h-screen overflow-x-hidden selection:bg-sky-500 selection:text-white">
		
		<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
			<div class="pulse-blob-1 absolute -top-40 -left-40 w-96 h-96 bg-indigo-600/40 rounded-full blur-[128px]"></div>
			
			<div class="pulse-blob-2 absolute top-1/3 -right-20 w-[500px] h-[500px] bg-sky-500/30 rounded-full blur-[140px]"></div>
			
			<div class="pulse-blob-3 absolute bottom-10 left-1/4 w-80 h-80 bg-violet-600/35 rounded-full blur-[120px]"></div>
			
			<div class="grid-animate absolute inset-0 bg-[linear-gradient(to_right,#1f293720_1px,transparent_1px),linear-gradient(to_bottom,#1f293720_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
		</div>

		<div class="relative z-10 max-w-6xl mx-auto px-4 py-12">
			<slot />
		</div>

	</body>
</html>